# Greenlight environment. Copy to .env.local (git-ignored) — or run `npm run env:init -- <project-ref>`,
# which creates it for you with the project URL filled in and fresh secrets generated.

# ── Supabase (shared project; Greenlight lives in its own `greenlight` schema) ─────────────────
# Public: inlined into the browser bundle. The publishable key is designed to be public — Row Level
# Security and column/table privileges protect data. Never put a secret / service-role key in a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. The app's own login: the dedicated, least-privilege `greenlight_app` role (created by
# `npm run db:migrate`). Use the *transaction pooler* host (port 6543) for the deployed app. Pooler
# usernames are `greenlight_app.<project-ref>`. `npm run env:compose` derives this line for you.
DATABASE_URL=postgresql://greenlight_app.<project-ref>:<GREENLIGHT_DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: connections per server instance (default 3; use 1 on serverless with the pooler).
# DATABASE_POOL_MAX=1

# ── Admin / one-time setup only — NEVER set these in Vercel ───────────────────────────────────
# The `postgres` role connection (Connect → Session pooler). Used by `npm run db:audit` and
# `npm run db:migrate`; the running app never sees it.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Password for the greenlight_app role. Generated locally by `npm run env:init`; set on the role by db:migrate.
GREENLIGHT_DB_PASSWORD=

# ── Base Sepolia ──────────────────────────────────────────────────────────────────────────────
# Optional: a dedicated RPC (Alchemy, QuickNode, …). Defaults to the public https://sepolia.base.org.
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>

# ── Scheduled sweep ───────────────────────────────────────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
