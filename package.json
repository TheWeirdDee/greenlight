  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "node -e \"process.env.LIVE_CHAIN=1;require('child_process').spawnSync('npx',['vitest','run','lib/chain/verifier.live.test.ts'],{stdio:'inherit',shell:true,env:process.env})\"",
    "test:e2e": "playwright test",
    "e2e:stack": "node e2e/support/stack.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:audit": "node scripts/audit.mjs",
    "env:init": "node scripts/env.mjs init",
    "env:compose": "node scripts/env.mjs compose",
    "env:status": "node scripts/env.mjs status",
    "db:rehearse": "node e2e/support/shared-project.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "framer-motion": "^14.9.0",
    "next": "16.4.4",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "undici": "^8.12.3",
    "viem": "^2.57.15",
    "wagmi": "^3.7.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
